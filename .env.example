# Cliente (prefijo VITE_, se incluyen en el bundle: nunca una clave de pago aquí)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Edge Functions (secretos de servidor, NUNCA con prefijo VITE_)
# supabase functions serve --env-file .env.local   ó   supabase secrets set --env-file .env.local
ANTHROPIC_API_KEY=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Azure Speech (STT/TTS de producción). Dejar vacío para usar Web Speech API / speechSynthesis del navegador como respaldo.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
